# Copy this file to `.env.local` and fill in the values you need.
# Only variables prefixed with VITE_ are exposed to the browser, so never put
# private API keys or secrets here — anything VITE_ ends up in the public bundle.

# Your deployed site URL (no trailing slash). Used for absolute Open Graph URLs.
# Example: VITE_SITE_URL=https://your-project.vercel.app
VITE_SITE_URL=

# Optional: a form endpoint that accepts JSON POST requests
# (for example a Formspree form URL). When set, the contact form sends
# messages there. When empty, the form opens the visitor's email app instead.
VITE_CONTACT_ENDPOINT=
